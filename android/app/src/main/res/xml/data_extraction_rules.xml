<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in this app is backed up or transferred: the web app's data lives in Chrome, and triage records must not
     leave the device through a cloud backup. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /></cloud-backup>
    <device-transfer><exclude domain="root" /></device-transfer>
</data-extraction-rules>
